# Beispiel-Umgebungsvariablen für Gridiron.
# Kopiere diese Datei nach ".env" (wird von git ignoriert) oder setze die
# Variablen direkt in deiner Shell / als Environment-Secret.

# Datenquelle: "nflverse" (echt) oder "sample" (offline-Demo/Tests).
GRIDIRON_SOURCE=nflverse

# Welche Saisons laden (Komma/Bereich), z.B. 2021-2024 oder 2022,2023,2024.
GRIDIRON_SEASONS=2021-2024

# Eigener Datenpfad (optional).
# GRIDIRON_DATA_DIR=data/gridiron

# Hinter HTTPS-Reverse-Proxy: Secure-Cookies aktivieren (für späteres Web).
# GRIDIRON_HTTPS=1
