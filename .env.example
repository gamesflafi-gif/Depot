# Beispiel-Umgebungsvariablen für die Aktien-KI.
# Kopiere diese Datei nach ".env" (wird von git ignoriert) oder setze die
# Variablen direkt in deiner Shell / als Environment-Secret.

# Optionaler NewsAPI.org-Key (kostenlos auf https://newsapi.org).
# Wird automatisch genutzt, sobald gesetzt – sonst ohne Fehler übersprungen.
STOCKAI_NEWSAPI_KEY=

# Benachrichtigung per Telegram (empfohlen fürs Handy):
#   1. In Telegram @BotFather schreiben -> /newbot -> Token erhalten
#   2. Eigene Chat-ID z.B. über @userinfobot ermitteln
# Mehrere erlaubte Nutzer (Allowlist): IDs mit Komma trennen, z.B. 123456,789012
# -> alle dürfen den Bot nutzen und bekommen die täglichen Nachrichten.
STOCKAI_TELEGRAM_TOKEN=
STOCKAI_TELEGRAM_CHAT_ID=

# Alternativ generischer Webhook (Discord/Slack/Mattermost): erwartet {"text": …}
STOCKAI_WEBHOOK_URL=
