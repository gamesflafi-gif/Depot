# Synapse wöchentliche Aktualisierung (Korpus + Index + Gehirn).
#   sudo cp deploy/synapse/refresh.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now synapse-refresh.timer
[Unit]
Description=Synapse Refresh (Korpus/Index/Gehirn)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Depot
Environment=SYNAPSE_MAILTO=gamesflafi@gmail.com
Environment=PER_THEME=2500
Environment=SINCE=2015
# länger laufender Lauf (Embeddings auf CPU) – kein Timeout-Abbruch:
TimeoutStartSec=0
ExecStart=/usr/bin/env bash deploy/synapse/refresh.sh
