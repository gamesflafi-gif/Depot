# Synapse Health-Watchdog (durch watchdog.timer alle 5 Min ausgelöst).
#   sudo cp deploy/synapse/watchdog.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now synapse-watchdog.timer
[Unit]
Description=Synapse Health-Watchdog

[Service]
Type=oneshot
WorkingDirectory=/root/Depot
# Optional Telegram-Alarm:
#   Environment=TG_TOKEN=...   Environment=TG_CHAT=...
ExecStart=/usr/bin/env bash deploy/synapse/watchdog.sh
