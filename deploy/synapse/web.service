# Synapse Web-Oberfläche als systemd-Dienst.
# Installieren:
#   sudo cp deploy/synapse/web.service /etc/systemd/system/synapse-web.service
#   (Pfad/User unten ggf. anpassen)
#   sudo systemctl daemon-reload && sudo systemctl enable --now synapse-web
[Unit]
Description=Synapse Web (Wissenschafts-Suche)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/Depot
# Hinter HTTPS-Reverse-Proxy (Caddy/Nginx) zusätzlich aktivieren:
#   Environment=SYNAPSE_HTTPS=1   -> Secure-Cookies + HSTS
ExecStart=/root/Depot/.venv/bin/python -m synapse.cli serve --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
